#!/usr/bin/env bash
# Launch a lifecycle hook under a Python interpreter that has been proven to run.
#
# Claude Code hands a hook's `command` string to a shell -- `sh -c` on macOS and Linux,
# Git Bash on Windows -- so a shell is a given. An interpreter is not. A bare `python`
# does not exist on Debian or Ubuntu without python-is-python3, and on Windows it is
# routinely the Microsoft Store stub: present on PATH, executable, and exits without
# running anything.
#
# That failure is silent, which is the whole problem. A hook that cannot start fails no
# gate and no command: pre_tool_policy simply stops denying --no-verify, force pushes and
# protected-branch pushes, stop_gate stops enforcing completion, and the session carries
# on looking green (Issue #38). So this wrapper is loud when it cannot resolve, and
# check_hook_entry in workflow/self_test.py fails the fast gate if a hook command ever
# goes back to naming an interpreter directly.
#
# Resolution is probed once and memoised. scripts/lib/python.sh accepts a candidate only
# by executing it, and these hooks run on every tool call, so paying for a probe per
# invocation is not acceptable. Nothing on the warm path forks a process.
set -euo pipefail

HOOK="${1:-}"

# Exit 2 blocks, and blocking is the safe answer only where a hook exists to deny
# something. Elsewhere it does harm: on Stop it blocks stopping, which loops instead of
# reporting, and on UserPromptSubmit it discards the prompt. Every other event reports a
# non-blocking error instead -- still surfaced to the user, still not silent.
FAIL=1
case " pre_tool_policy.py permission_request.py " in
  *" ${HOOK##*/} "*) FAIL=2 ;;
esac

# Absolute paths only, enforced everywhere a path is trusted. `command -v` echoes a
# relative candidate straight back, so PYTHON_BIN=./py would otherwise be memoised and
# then exec'd against whatever working directory a hook happened to inherit. Written as a
# `case` rather than `[[ =~ ]]` so the Windows drive-letter form needs no regex quoting.
absolute() {
  case "$1" in
    /*) return 0 ;;
    [A-Za-z]:[/\\]*) return 0 ;;
    *) return 1 ;;
  esac
}

ROOT="${CLAUDE_PROJECT_DIR:-}"
if [[ -z "$ROOT" ]]; then
  echo "hook runner: CLAUDE_PROJECT_DIR is unset, so the repository cannot be located." >&2
  echo "hook runner: repository policy hooks are NOT enforcing." >&2
  exit "$FAIL"
fi

# The shared git directory, so a worktree and its main checkout keep one cache. Read with
# builtins rather than sed: a worktree's .git is always a file, so a fork here would be a
# fork on every tool call for anyone working in one.
GIT_DIR="$ROOT/.git"
if [[ -f "$GIT_DIR" ]]; then
  # A linked worktree and a submodule both replace .git with a file naming the real
  # directory, and the path it names is often relative to this checkout -- always so under
  # worktree.useRelativePaths. Left relative it would resolve against the inherited
  # working directory, so the cache would land somewhere else, or nowhere, and every tool
  # call would pay for a fresh probe without saying so.
  POINTER=""
  IFS= read -r POINTER <"$GIT_DIR" || true
  POINTER="${POINTER%$'\r'}"
  if [[ "$POINTER" == "gitdir: "* ]]; then
    GIT_DIR="${POINTER#gitdir: }"
    absolute "$GIT_DIR" || GIT_DIR="$ROOT/$GIT_DIR"
  else
    GIT_DIR=""
  fi
  # A worktree's directory is <main>/.git/worktrees/<name>; strip back so it shares one
  # cache with its main checkout. A submodule's is <super>/.git/modules/<name>, which has
  # no such suffix and is already the right place.
  GIT_DIR="${GIT_DIR%/worktrees/*}"
fi
# An unreadable or unparseable .git file would otherwise put the cache at /claude/cache --
# outside the repository, somewhere another principal may be able to write a binary this
# script then execs on every tool call.
absolute "$GIT_DIR" || GIT_DIR="$ROOT/.git"
CACHE="$GIT_DIR/claude/cache/hook-interpreter"

PY=""
if [[ -r "$CACHE" ]]; then
  # `read` reports failure at end-of-file without a trailing newline *after* assigning, so
  # discarding the value on non-zero status would throw away a perfectly good path and
  # re-probe on every call. IFS is cleared so a path containing spaces survives.
  IFS= read -r PY <"$CACHE" || true
  PY="${PY%$'\r'}"
  absolute "$PY" || PY=""
fi

if [[ -z "$PY" || ! -x "$PY" ]]; then
  RESOLVER="$ROOT/scripts/lib/python.sh"
  # Checked before sourcing: `set -e` would abort on a missing file and exit 1 with only
  # bash's own message, which is the silent non-enforcement this wrapper exists to prevent.
  if [[ ! -r "$RESOLVER" ]]; then
    echo "hook runner: $RESOLVER is missing, so $HOOK did not run." >&2
    echo "hook runner: repository policy hooks are NOT enforcing." >&2
    exit "$FAIL"
  fi
  # shellcheck source=scripts/lib/python.sh
  . "$RESOLVER"
  if ! PY="$(resolve_python)" || ! PY="$(command -v "$PY")"; then
    echo "hook runner: no working Python 3.10+ interpreter, so $HOOK did not run." >&2
    echo "hook runner: repository policy hooks are NOT enforcing." >&2
    echo "hook runner: install Python 3.10+ or set PYTHON_BIN to one." >&2
    exit "$FAIL"
  fi
  # Only an absolute path is worth remembering. A relative one still runs this time --
  # python.sh proved it by executing it from here -- but memoising it would hand the next
  # invocation a different binary depending on where it was started.
  #
  # Written through a temporary file and renamed: hooks run concurrently on parallel tool
  # calls, and a reader that catches a truncate-then-write halfway sees an empty cache and
  # pays for the full probe.
  if absolute "$PY"; then
    (
      umask 077
      mkdir -p "${CACHE%/*}" &&
        printf '%s\n' "$PY" >"$CACHE.$$" &&
        mv -f "$CACHE.$$" "$CACHE"
    ) 2>/dev/null || rm -f "$CACHE.$$" 2>/dev/null || true
  fi
fi

exec "$PY" "$@"
