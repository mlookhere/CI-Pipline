{
  "version": 1,
  "name": "Chat FreePT CI Pipeline",
  "repository": "mlookhere/CI-Pipline",
  "status": "planning",
  "agent": {
    "provider": "chatgpt",
    "tool": "github-mcp",
    "exclusive": true,
    "github_source_of_truth": true,
    "background_worker": false
  },
  "branches": {
    "integration": "dev",
    "production": "master",
    "requested_production": "main",
    "default": "dev",
    "rename_pending_verification": true
  },
  "tracking": {
    "control_issue": 1,
    "planning_issue": 95,
    "work_prefix": "work",
    "required_pr_sections": [
      "Result",
      "Implementation",
      "Verification",
      "Risk",
      "Remaining work"
    ],
    "max_failed_fixes_per_cause": 3
  },
  "commands": {
    "bootstrap": "./scripts/bootstrap --ci",
    "fast": "./ci/run fast",
    "pr": "./ci/run pr",
    "release": "./ci/run release",
    "nightly": "./ci/run nightly",
    "audit": "./ci/run audit"
  },
  "required_checks": {
    "integration": [
      "PR metadata",
      "Fast deterministic gates",
      "PR test/build gates",
      "Dependency audit",
      "Workflow policy"
    ],
    "production": [
      "Release metadata",
      "Full regression and production build",
      "Workflow policy"
    ],
    "require_completed": true,
    "zero_is_success": false
  },
  "migration": {
    "legacy_runtime_present": true,
    "legacy_config": ".claude-workflow.json",
    "neutral_migration_pending": true,
    "do_not_vendor": [
      ".claude/",
      ".claude-workflow.json",
      ".github/claude/",
      "CLAUDE.md",
      ".github/workflows/claude-review.yml",
      "scripts/claude-exec",
      "scripts/claude-lease"
    ]
  },
