{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 180
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 1200
          },
          "recommendation": {
            "type": "string",
            "maxLength": 1200
          }
        },
        "required": [
          "severity",
          "title",
          "path",
          "line",
          "evidence",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "needs_human_review": {
      "type": "boolean"
    }
  },
  "required": [
    "summary",
    "findings",
    "needs_human_review"
  ],
  "additionalProperties": false
}
