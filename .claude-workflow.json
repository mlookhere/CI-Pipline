{
  "version": 2,
  "branches": {
    "integration": "dev",
    "production": "master"
  },
  "worktrees": {
    "root": "../.worktrees",
    "branch_prefix": "work"
  },
  "github": {
    "control_issue_title": "[CONTROL] Current repository state",
    "release_title_prefix": "[RELEASE]",
    "state_labels": [
      "state:ready",
      "state:active",
      "state:blocked",
      "state:review",
      "state:release-ready"
    ],
    "risk_paths": {
      "risk:ci": [
        ".github/workflows/**",
        ".github/actions/**",
        "ci/**",
        "workflow/**",
        ".claude/**",
        ".claude-workflow.json"
      ],
      "risk:database": [
        "**/migrations/**",
        "**/schema/**",
        "**/schema.*"
      ],
      "risk:security": [
        "**/auth/**",
        "**/security/**",
        "**/*permission*",
        "**/*authorization*",
        ".env.example"
      ],
      "risk:deployment": [
        "ops/**",
        "infra/**",
        "Dockerfile",
        "k8s/**",
        "helm/**"
      ],
      "risk:dependencies": [
        "pyproject.toml",
        "requirements.txt",
        "ci/requirements-ci.txt",
        "uv.lock",
        "poetry.lock"
      ]
    },
    "branch_protection": {
      "integration": {
        "required_checks": [
          "PR metadata",
          "Fast deterministic gates",
          "PR test/build gates",
          "Dependency audit",
          "Workflow policy"
        ],
        "required_approving_reviews": 0
      },
      "production": {
        "required_checks": [
          "Release metadata",
          "Full regression and production build",
          "Workflow policy"
        ],
        "required_approving_reviews": 0
      }
    },
    "expected_owner": "mlookhere",
    "expected_repository": "CI-Pipline"
  },
  "project": {
    "package_dir": "",
    "packaged_assets": [],
    "typed_advisory_witness": "",
    "executables": [],
    "forbidden_call_sites": []
  },
  "token_control": {
    "capture_noisy_commands": true,
    "session_context_max_chars": 7200,
    "large_prompt_chars": 12000
  },
  "commands": {
    "bootstrap_local": [
      "\"$CI_PYTHON\" -m pytest --version",
      "\"$CI_PYTHON\" -m mypy --version",
      "\"$CI_PYTHON\" -m ruff --version",
      "\"$CI_PYTHON\" -m pip_audit --version"
    ],
    "bootstrap_ci": [
      "\"$CI_PYTHON\" -m pytest --version",
      "\"$CI_PYTHON\" -m mypy --version",
      "\"$CI_PYTHON\" -m ruff --version",
      "\"$CI_PYTHON\" -m pip_audit --version"
    ],
    "format_check": [
      "ruff format --check ."
    ],
    "lint": [
      "ruff check ."
    ],
    "typecheck": [
      "mypy"
    ],
    "unit": [
      "\"$PROJECT_PYTHON\" -m pytest -q"
    ],
    "coverage": [
      "\"$PROJECT_PYTHON\" -m pytest tests -q --cov=workflow --cov=ci --cov-report=term --cov-fail-under=52"
    ],
    "security": [
      "pip-audit -r ci/requirements-ci.txt --strict"
    ],
    "workflow_self_test": [
      "\"$CI_PYTHON\" workflow/self_test.py --ci"
    ]
  },
  "stages": {
    "fast": [
      "workflow_self_test",
      "quality",
      "format_check",
      "lint",
      "typecheck"
    ],
    "pr": [
      "unit",
      "coverage"
    ],
    "release": [
      "security",
      "unit",
      "coverage"
    ],
    "nightly": [
      "security",
      "unit",
      "coverage"
    ],
    "audit": [
      "security"
    ],
    "bootstrap-local": [
      "bootstrap_local"
    ],
    "bootstrap-ci": [
      "bootstrap_ci"
    ]
  },
  "quality": {
    "base_ref": "origin/dev",
    "max_changed_file_lines": 1500,
    "max_function_lines": 120,
    "max_cyclomatic_complexity": 15,
    "require_issue_for_todo": true,
    "banned_phrases": [
      "in today's fast-paced",
      "it is important to note",
      "delve into",
      "seamlessly integrates",
      "robust and scalable solution"
    ],
    "text_extensions": [
      ".md",
      ".mdx",
      ".txt",
      ".py"
    ],
    "source_extensions": [
      ".py",
      ".js",
      ".ts"
    ],
    "exclude_globs": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.ci-venv/**",
      "data/**",
      "artifacts/**",
      "**/*.min.js",
      "**/*.map",
      "**/fixtures/**",
      "uv.lock",
      "poetry.lock"
    ],
    "max_identical_command_failures": 3,
    "max_pr_files": 80,
    "max_pr_changed_lines": 4000
  },
  "tracking": {
    "require_issue_for_mutation_prompts": true,
    "lease_ttl_seconds": 28800,
    "optimistic_issue_updates": true,
    "control_issue_max_active_rows": 20
  }
}
